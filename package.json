{
  "name": "codeforces-coach",
  "version": "1.0.0",
  "description": "CF Coach — a local-first Codeforces coach: it writes a solution, a brute force and a data generator, verifies them against each other on your machine, and only then teaches the problem with a rich, figure-annotated document. All data stays local.",
  "private": true,
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noctashrum/CodeForces-Coach.git"
  },
  "keywords": [
    "codeforces",
    "competitive-programming",
    "algorithm",
    "coach",
    "electron",
    "local-first",
    "stress-testing"
  ],
  "author": "Noctashrum",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "diag": "node scripts/diag.js",
    "icon": "node scripts/gen-icon.js",
    "pack": "node scripts/pack.js",
    "install:local": "node scripts/install-local.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.3.0"
  }
}
